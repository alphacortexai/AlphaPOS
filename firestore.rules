rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function rawEmail() {
      return request.auth.token.email is string ? request.auth.token.email : '';
    }
    function email() {
      return rawEmail().lower();
    }
    function sameMail(stored) {
      return stored is string && stored != '' && (stored == rawEmail() || stored.lower() == email());
    }
    function staffGrant(owner) {
      let grant = get(/databases/$(database)/documents/shopMemberships/$(owner + '_' + email()));
      return grant != null
        && email() != ''
        && grant.exists
        && sameMail(grant.data.email)
        && (
          !('ownerUid' in grant.data)
          || grant.data.ownerUid == null
          || grant.data.ownerUid == owner
        );
    }
    function listedOnShop() {
      return resource != null
        && email() != ''
        && resource.data.get('staffEmails', []) is list
        && email() in resource.data.get('staffEmails', []);
    }
    function role(owner) {
      let grant = get(/databases/$(database)/documents/shopMemberships/$(owner + '_' + email()));
      return request.auth.uid == owner
        ? 'shop_owner'
        : (grant != null && email() != '' && grant.exists && sameMail(grant.data.email) ? grant.data.role : '');
    }
    function isStaff(owner) {
      return signedIn() && (request.auth.uid == owner || staffGrant(owner));
    }
    function roleHas(owner, key) {
      let r = role(owner);
      return r == 'shop_owner'
        || (r == 'admin' && key in ['sell', 'salesHistory', 'customers', 'products', 'editCatalog', 'seeCost', 'expenses', 'reports', 'accounts', 'activity', 'manageStaff', 'allBranches'])
        || (r == 'manager' && key in ['sell', 'salesHistory', 'customers', 'products', 'editCatalog', 'seeCost', 'expenses', 'reports', 'accounts', 'activity', 'allBranches'])
        || (r == 'cashier' && key in ['sell', 'salesHistory', 'customers', 'products', 'allBranches'])
        || (r == 'stock' && key in ['products', 'editCatalog', 'seeCost', 'allBranches']);
    }
    function grantAllows(owner, key) {
      let grant = get(/databases/$(database)/documents/shopMemberships/$(owner + '_' + email()));
      let invited = grant != null && email() != '' && grant.exists && sameMail(grant.data.email);
      return request.auth.uid == owner
        || (invited && (
          (grant.data.permissions is list && key in grant.data.permissions)
          || (!(grant.data.permissions is list) && roleHas(owner, key))
        ));
    }
    function hasPerm(owner, key) {
      return grantAllows(owner, key);
    }
    function tillChange() {
      return request.resource != null
        && resource != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customers', 'heldTickets', 'cashSessions', 'revision', 'updatedAt', 'ledgerSplit'
        ]);
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function shopPatchAllowed(owner) {
      let changed = changedKeys();
      return changed.hasOnly([
        'products', 'services', 'suppliers', 'expenseGroups',
        'customers', 'heldTickets', 'cashSessions',
        'revision', 'updatedAt', 'ledgerSplit'
      ])
      && (!changed.hasAny(['products', 'services', 'suppliers', 'expenseGroups']) || grantAllows(owner, 'editCatalog'))
      && (!changed.hasAny(['customers', 'heldTickets', 'cashSessions']) || grantAllows(owner, 'sell') || grantAllows(owner, 'customers'));
    }

    match /shopMemberships/{id} {
      allow get: if signedIn() && (resource.data.ownerUid == request.auth.uid || sameMail(resource.data.email));
      allow list: if signedIn() && resource.data.email == rawEmail();
      allow list: if signedIn() && resource.data.email == email();
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.role in ['admin', 'manager', 'cashier', 'stock']
        && (!('permissions' in request.resource.data) || request.resource.data.permissions is list);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{owner}/pos/data {
      // Products and branches live on this document. The owner, an invite, or an email saved on the shop may read them.
      allow read: if signedIn() && (request.auth.uid == owner || listedOnShop() || staffGrant(owner));
      allow create: if signedIn() && request.auth.uid == owner;
      allow update: if signedIn() && (
        request.auth.uid == owner
        || (listedOnShop() && tillChange() && !staffGrant(owner))
        || (staffGrant(owner) && shopPatchAllowed(owner))
      );
      allow delete: if signedIn() && request.auth.uid == owner;
    }
    match /users/{owner}/pos/data/stock/{productId} {
      allow read: if isStaff(owner);
      allow create, update: if hasPerm(owner, 'sell') || hasPerm(owner, 'editCatalog');
    }
    match /users/{owner}/pos/data/sales/{saleId} {
      allow read: if isStaff(owner);
      allow create: if hasPerm(owner, 'sell');
      allow update: if hasPerm(owner, 'reports');
      allow delete: if false;
    }
    match /users/{owner}/pos/data/expenses/{expenseId} {
      allow read: if hasPerm(owner, 'expenses') || hasPerm(owner, 'reports');
      allow write: if hasPerm(owner, 'expenses');
    }
    match /users/{owner}/pos/data/payments/{paymentId} {
      allow read: if isStaff(owner);
      allow create, update: if hasPerm(owner, 'customers');
      allow delete: if signedIn() && request.auth.uid == owner;
    }
    match /users/{owner}/pos/data/supplierBills/{billId} {
      allow read: if hasPerm(owner, 'editCatalog') || hasPerm(owner, 'seeCost');
      allow write: if hasPerm(owner, 'editCatalog');
    }
    match /users/{owner}/pos/data/supplierPayments/{paymentId} {
      allow read: if hasPerm(owner, 'expenses') || hasPerm(owner, 'accounts');
      allow write: if hasPerm(owner, 'expenses');
    }
    match /users/{owner}/pos/activity {
      allow read, write: if signedIn() && (request.auth.uid == owner || hasPerm(owner, 'activity'));
    }
    match /users/{owner}/pos/images {
      allow read: if isStaff(owner);
      allow write: if hasPerm(owner, 'editCatalog');
    }
    match /users/{owner}/pos/secrets {
      allow read, write: if signedIn() && request.auth.uid == owner;
    }
  }
}
