rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function rawEmail() {
      return request.auth.token.email is string ? request.auth.token.email : '';
    }
    function email() {
      return rawEmail().lower();
    }
    function sameMail(stored) {
      return stored is string && stored != '' && (stored == rawEmail() || stored.lower() == email());
    }
    function staffGrant(owner) {
      let grant = get(/databases/$(database)/documents/shopMemberships/$(owner + '_' + email()));
      return email() != ''
        && grant.exists
        && grant.data.get('email', '') is string
        && sameMail(grant.data.get('email', ''))
        && (
          !('ownerUid' in grant.data)
          || grant.data.get('ownerUid', null) == null
          || grant.data.get('ownerUid', null) == owner
        );
    }
    function listedOnShop() {
      return resource != null
        && email() != ''
        && resource.data.get('staffEmails', []) is list
        && email() in resource.data.get('staffEmails', []);
    }
    function shopData(owner) {
      let path = /databases/$(database)/documents/users/$(owner)/pos/data;
      return exists(path) ? get(path).data : null;
    }
    function emailListed(data) {
      return data != null && email() != '' && data.get('staffEmails', []) is list && email() in data.get('staffEmails', []);
    }
    function stringList(data, field) {
      return data is map && data.keys().hasAny([field]) && data.get(field, []) is list ? data.get(field, []) : [];
    }
    function hasEmail(list) {
      return (list.size() == 1 && list[0] == email())
        || (list.size() == 2 && (list[0] == email() || list[1] == email()))
        || (list.size() == 3 && (list[0] == email() || list[1] == email() || list[2] == email()))
        || (list.size() == 4 && (list[0] == email() || list[1] == email() || list[2] == email() || list[3] == email()))
        || (list.size() == 5 && (list[0] == email() || list[1] == email() || list[2] == email() || list[3] == email() || list[4] == email()))
        || (list.size() == 6 && (list[0] == email() || list[1] == email() || list[2] == email() || list[3] == email() || list[4] == email() || list[5] == email()));
    }
    // Expenses, reports, balances, and the activity log are not on the seller or editor lists.
    // Those switches live on the invite, so the books follow that record.
    function bookKey(key) {
      return key == 'expenses' || key == 'reports' || key == 'accounts' || key == 'activity';
    }
    function membershipAllows(owner, key) {
      let path = /databases/$(database)/documents/shopMemberships/$(owner + '_' + email());
      let grant = exists(path) ? get(path).data : null;
      let permissions = grant is map && grant.keys().hasAny(['permissions']) && grant.get('permissions', []) is list
        ? grant.get('permissions', [])
        : [];
      let openRole = grant is map && !grant.keys().hasAny(['permissions']) && grant.get('role', '') in ['manager', 'admin'];
      return bookKey(key)
        && grant is map
        && email() != ''
        && sameMail(grant.get('email', ''))
        && (
          !grant.keys().hasAny(['ownerUid'])
          || grant.get('ownerUid', '') == null
          || grant.get('ownerUid', '') == owner
        )
        && ((permissions.size() > 0 && key in permissions) || openRole);
    }
    // sellerEmails and editorEmails hold up to six people. Until those fields exist, up to six people listed on the shop may sell.
    function hasPerm(owner, key) {
      let data = shopData(owner);
      let split = data is map && data.keys().hasAny(['sellerEmails', 'editorEmails']);
      let sellers = stringList(data, 'sellerEmails');
      let editors = stringList(data, 'editorEmails');
      let staff = data is map && data.get('staffEmails', []) is list ? data.get('staffEmails', []) : [];
      return request.auth.uid == owner
        || (bookKey(key) && membershipAllows(owner, key))
        || (hasEmail(sellers) && (key == 'sell' || key == 'salesHistory' || key == 'customers' || key == 'products' || key == 'allBranches'))
        || (hasEmail(editors) && (key == 'products' || key == 'editCatalog' || key == 'seeCost' || key == 'allBranches'))
        || (!split && hasEmail(staff) && (key == 'sell' || key == 'salesHistory' || key == 'customers' || key == 'products' || key == 'allBranches'));
    }
    function expenseListShrunk() {
      let kept = 'expenses' in request.resource.data;
      let next = kept ? request.resource.data.get('expenses', []) : [];
      let prior = resource.data.get('expenses', []);
      return !kept || (prior is list && next is list && next.size() <= prior.size());
    }
    function isStaff(owner) {
      return request.auth.uid == owner || emailListed(shopData(owner)) || hasPerm(owner, 'editCatalog');
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function shopPatchAllowed(owner) {
      let changed = changedKeys();
      return changed.hasOnly([
        'products', 'services', 'suppliers', 'expenseGroups',
        'customers', 'heldTickets', 'cashSessions',
        'expenses', 'removedExpenseIds',
        'revision', 'updatedAt', 'ledgerSplit'
      ])
      && (!changed.hasAny(['products', 'services', 'suppliers', 'expenseGroups']) || hasPerm(owner, 'editCatalog'))
      && (!changed.hasAny(['customers', 'heldTickets', 'cashSessions']) || hasPerm(owner, 'sell'))
      && (!changed.hasAny(['expenses', 'removedExpenseIds']) || (hasPerm(owner, 'expenses') && (!changed.hasAny(['expenses']) || expenseListShrunk())));
    }

    match /shopMemberships/{id} {
      allow get: if signedIn() && (resource.data.ownerUid == request.auth.uid || sameMail(resource.data.email));
      allow list: if signedIn() && resource.data.email == rawEmail();
      allow list: if signedIn() && resource.data.email == email();
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.role in ['admin', 'manager', 'cashier', 'stock']
        && (!('permissions' in request.resource.data) || request.resource.data.permissions is list);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{owner}/pos/data {
      // The owner allow stands alone so a missing shop document does not trip the invite checks.
      allow read: if signedIn() && request.auth.uid == owner;
      allow read: if signedIn() && listedOnShop();
      allow read: if signedIn() && staffGrant(owner);
      allow create: if signedIn() && request.auth.uid == owner;
      allow update: if signedIn() && request.auth.uid == owner;
      allow update: if signedIn() && request.auth.uid != owner && shopPatchAllowed(owner);
      allow delete: if signedIn() && request.auth.uid == owner;
    }
    match /users/{owner}/pos/data/stock/{productId} {
      allow read: if isStaff(owner);
      allow create, update: if hasPerm(owner, 'editCatalog') || hasPerm(owner, 'sell');
    }
    match /users/{owner}/pos/data/sales/{saleId} {
      allow read: if isStaff(owner);
      allow create: if hasPerm(owner, 'sell');
      allow update: if hasPerm(owner, 'reports');
      allow delete: if false;
    }
    match /users/{owner}/pos/data/expenses/{expenseId} {
      allow read: if hasPerm(owner, 'expenses') || hasPerm(owner, 'reports');
      allow write: if hasPerm(owner, 'expenses');
    }
    match /users/{owner}/pos/data/payments/{paymentId} {
      allow read: if isStaff(owner);
      allow create, update: if hasPerm(owner, 'customers');
      allow delete: if signedIn() && request.auth.uid == owner;
    }
    match /users/{owner}/pos/data/supplierBills/{billId} {
      allow read: if hasPerm(owner, 'editCatalog') || hasPerm(owner, 'seeCost');
      allow write: if hasPerm(owner, 'editCatalog');
    }
    match /users/{owner}/pos/data/supplierPayments/{paymentId} {
      allow read: if hasPerm(owner, 'expenses') || hasPerm(owner, 'accounts');
      allow write: if hasPerm(owner, 'expenses');
    }
    match /users/{owner}/pos/activity {
      allow read, write: if signedIn() && (request.auth.uid == owner || hasPerm(owner, 'activity'));
    }
    match /users/{owner}/pos/images {
      allow read: if isStaff(owner);
      allow write: if hasPerm(owner, 'editCatalog');
    }
    match /users/{owner}/pos/secrets {
      allow read, write: if signedIn() && request.auth.uid == owner;
    }
  }
}
