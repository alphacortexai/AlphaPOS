NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Shop email for sales reports and staff invites. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Optional. The shop owner can paste a Gemini key in Settings instead. A key here is used when Settings is empty.
GEMINI_API_KEY=
OPENAI_API_KEY=
# CATALOG_ASSISTANT_PROVIDER=gemini
# CATALOG_ASSISTANT_MODEL=gemini-3.8-flash
# Set to false to refuse the on-device counter. Signed-in shops always require the owner.
# CATALOG_ASSISTANT_ALLOW_LOCAL=false
